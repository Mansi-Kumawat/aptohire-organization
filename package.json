{
  "name": "aptohire-organization",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts --host 0.0.0.0 --port 5176 --strictPort",
    "build": "tsc -b frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json",
    "lint": "eslint frontend/src --max-warnings=0",
    "test": "vitest run --config frontend/vite.config.ts",
    "e2e": "playwright test",
    "db:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_REF > frontend/src/lib/database.types.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "@tanstack/react-query": "5.66.9",
    "@vitejs/plugin-react": "4.3.4",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-helmet-async": "2.0.5",
    "react-router-dom": "^7.18.4",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "eslint": "^9.39.5",
    "jsdom": "^26.0.0",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  }
}
